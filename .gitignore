# OctopusTorrent — ignore rules.
# Do not hide source code, generated Wails bindings (frontend/wailsjs/),
# package configuration (build/darwin/, build/appicon.png) or synthetic test data (testdata/).

# Wails and Vite build output
/build/bin/
/frontend/dist/
# The engine spike app (task 007; deleted by 034): its .app and its Vite build
/cmd/engine-spike/build/bin/
/cmd/engine-spike/assets/

# Skills Codex generates locally from .claude/commands (owner's decision of 2026-10-17); their
# relative links point nowhere from there
/.agents/

# Frontend dependencies (reproduced from the lockfile)
node_modules/
# Wails CLI cache: package.json checksum used to skip npm install
/frontend/package.json.md5

# Working SQLite databases: application library, engine piece completion, WAL journals
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3

# Coverage profiles and reports (kept as evidence only in docs/verification/ when needed)
coverage.out
*.coverprofile
cover.html
coverage/

# Local logs, temporary files
*.log
logs/
tmp/
*.tmp

# Personal torrents and downloaded data never go into Git.
*.torrent
downloads/

# Local environment and editor settings
.env
.env.*
.vscode/
.idea/

# Synthetic test data (torrents, corrupted databases, etc.) is always tracked.
!testdata/**
!**/testdata/**

# macOS (after the testdata exception, so it stays out of Git there too)
.DS_Store

# Personal Claude Code permission allowlist (copied into workspaces by .octopus/carry)
/.claude/settings.local.json
