{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test ./...)",
      "Bash(go vet ./...)",
      "Bash(gofmt -l .)",
      "Bash(go tool wails generate module)",
      "Bash(go tool wails build -clean -trimpath)",
      "Bash(go tool wails doctor)",
      "Bash(npm --prefix frontend ci)",
      "Bash(npm --prefix frontend run build)",
      "Bash(npm --prefix frontend run typecheck)",
      "Bash(npm --prefix frontend run test)",
      "Bash(npm --prefix frontend run test:coverage)",
      "Bash(npm --prefix frontend audit)",
      "Bash(npm --prefix frontend outdated)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git branch --list)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go tool devtool hook release-guard",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
